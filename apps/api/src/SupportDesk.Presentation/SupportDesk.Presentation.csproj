<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Web API and composition root. Maps HTTP to the application's commands and queries. -->
  <ItemGroup>
    <ProjectReference Include="../SupportDesk.Application/SupportDesk.Application.csproj" />
    <ProjectReference Include="../SupportDesk.Infrastructure/SupportDesk.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    appsettings.Development.json holds a local database password and a development signing key. It
    exists for a developer's machine only, so no published build, and so no container image, takes it.
  -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Required for the EF Core CLI to use this project as its startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
