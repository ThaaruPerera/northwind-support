{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "NorthwindSupport",
    "Audience": "NorthwindSupport.Web",
    "LifetimeMinutes": 480
  },
  "Sla": {
    "BaseWindowHours": {
      "Low": 72,
      "Medium": 24,
      "High": 8,
      "Critical": 4
    },
    "PremiumCustomerMultiplier": 0.5,
    "MinimumWindowHours": 1,
    "AtRiskThresholdPercent": 25
  }
}
